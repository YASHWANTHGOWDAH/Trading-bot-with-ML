{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: TradeMind Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Launch Chrome against Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Browser",
      "configurations": [
        "Python: TradeMind Backend (FastAPI)",
        "Launch Chrome against Frontend"
      ]
    }
  ]
}
